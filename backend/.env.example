# ── Runtime ──
NODE_ENV=development
PORT=5000

# ── Database ──
MONGODB_URI=mongodb://127.0.0.1:27017/kidscape

# ── Auth (JWT + bcrypt) ──
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ── CORS (comma-separated origins allowed to call the API) ──
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Rate limiting (login brute-force protection) ──
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# ── Chatbot (Google Gemini) ──
# Get a key at https://aistudio.google.com/apikey. Leave empty to disable the
# chatbot (the API still runs; /chat/ask returns 503).
GEMINI_API_KEY=
# Flash-Lite: miễn phí (free tier 15 req/phút, 1.500 req/ngày), rẻ nhất, hợp Q&A ngắn.
GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_MAX_OUTPUT_TOKENS=512
# GEMINI_TEMPERATURE=0.3
# GEMINI_MAX_CONTEXT_CHARS=24000
# CHAT_MAX_INPUT=500
# CHAT_RATE_MAX=20
# CHAT_RATE_WINDOW_MIN=5

# ── Seed: first admin account (npm run seed) ──
SEED_ADMIN_NAME=Admin KidScape
SEED_ADMIN_EMAIL=admin@kidscape.vn
SEED_ADMIN_PASSWORD=ChangeMe123!
