# ──────────────────────────────────────────────────────────────
# KidScape — production environment variables
# Paste these into Coolify → your resource → Environment Variables.
# Generate secrets with:
#   openssl rand -hex 32        (JWT_SECRET)
#   openssl rand -base64 24     (passwords)
# ──────────────────────────────────────────────────────────────

# Public URL of the site (your domain) — used for CORS.
# NOTE: set the domain that Traefik routes on the FRONTEND service in
# Coolify's "Domains" tab — not via this variable.
APP_URL=https://kidscape.your-domain.com

# MongoDB root credentials (used inside the mongo container)
MONGO_USER=kidscape
MONGO_PASSWORD=__change_me_strong_random__

# JWT — MUST be a strong, unique value (>= 24 chars) or the backend refuses to boot
JWT_SECRET=__paste_openssl_rand_hex_32__
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# Proxy hops in front of the API (Coolify Traefik + nginx = 2) — required so login
# rate limiting keys on the real client IP instead of an internal proxy IP.
TRUST_PROXY=2

# Rate limiting (login brute-force protection)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_WINDOW_MIN=15

# Chatbot (Google Gemini) — get a key at https://aistudio.google.com/apikey.
# Leave empty to keep the chatbot disabled (the site + auth still work; /chat/ask
# returns 503). The chip suggestions still answer client-side without a key.
GEMINI_API_KEY=
# Flash-Lite: free tier (15 req/phút, 1.500 req/ngày) — rẻ nhất, đủ cho chatbot grounding.
GEMINI_MODEL=gemini-3.1-flash-lite

# First admin — auto-seeded on first boot (create-only).
# In production the backend REFUSES to seed if this is empty or the example value,
# so set a STRONG password BEFORE the first deploy.
SEED_ADMIN_NAME=Admin KidScape
SEED_ADMIN_EMAIL=admin@your-domain.com
SEED_ADMIN_PASSWORD=__change_me_strong_password__
